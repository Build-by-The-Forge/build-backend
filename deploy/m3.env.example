# Copy to deploy/m3.env (git-ignored) for deploy/compose.m3.yml.
# Development topology only. Use fresh random values of at least 32 bytes,
# for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The two service secrets must differ.

POSTGRES_SUPERUSER_PASSWORD=
BUILD_BACKEND_OWNER_PASSWORD=
BUILD_BACKEND_APP_PASSWORD=
BUILD_AI_OWNER_PASSWORD=
BUILD_AI_APP_PASSWORD=

BACKEND_TO_AI_SECRET=
AI_TO_BACKEND_SECRET=

# Object storage identities (object-storage service). Access keys: letters
# and digits, e.g. python -c "import secrets; print(secrets.token_hex(10))".
OBJECT_STORAGE_ADMIN_ACCESS_KEY=
OBJECT_STORAGE_ADMIN_SECRET_KEY=
OBJECT_STORAGE_BACKEND_ACCESS_KEY=
OBJECT_STORAGE_BACKEND_SECRET_KEY=
OBJECT_STORAGE_AI_ACCESS_KEY=
OBJECT_STORAGE_AI_SECRET_KEY=

# Optional
# M3_BACKEND_PORT=18000
# MODEL_PROVIDER=deterministic
